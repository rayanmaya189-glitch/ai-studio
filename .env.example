# Copy to .env and fill in only what you use. EVERY value is optional:
# with no provider credentials set, ADS falls back to the built-in `stub`
# provider so the whole app still runs end-to-end.

# ---- Backing services ----
DATABASE_URL=postgresql+psycopg://ads:ads@localhost:5432/ads
QDRANT_URL=http://localhost:6333
# When Qdrant is unreachable, RAG vectors fall back to this local on-disk dir.
LOCAL_VECTOR_PATH=./vector_data
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ads-password

# ---- Default model selection ----
# Format: "<provider>:<model>". Provider must be one of:
# stub | ollama | openai | openrouter | nim | anthropic
DEFAULT_CHAT_MODEL=stub:echo
DEFAULT_EMBED_MODEL=stub:echo-embed

# ---- LLM providers (set only those you have) ----
# Ollama (local, no key needed; just needs the daemon running)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NVIDIA NIM (OpenAI-compatible)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- Backend ----
CORS_ORIGINS=http://localhost:3000
